{
  "name": "relay-local-share",
  "private": true,
  "description": "Private local file sharing between devices",
  "author": "Relay",
  "version": "1.0.0",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "server": "node server.cjs",
    "start": "node server.cjs",
    "electron:dev": "concurrently \"npm run server\" \"vite --host 0.0.0.0\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:pack": "electron-builder --dir"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "express": "latest",
    "lucide-react": "latest",
    "multer": "latest",
    "qrcode": "latest",
    "react": "latest",
    "react-dom": "latest",
    "socket.io": "latest",
    "socket.io-client": "^4.8.3",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.relay.localshare",
    "productName": "Relay",
    "copyright": "Copyright © 2024 Relay",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "electron-preload.cjs",
      "server.cjs",
      "public/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public",
        "filter": ["**/*"]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "public/icon.svg",
      "maintainer": "Relay <relay@example.com>",
      "description": "Private local file sharing between devices"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.svg",
      "publisherName": "Relay",
      "certificateFile": "",
      "certificatePassword": ""
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Relay",
      "uninstallDisplayName": "Relay",
      "license": "",
      "installerIcon": "public/icon.svg",
      "uninstallerIcon": "public/icon.svg",
      "installerHeaderIcon": "public/icon.svg"
    },
    "portable": {
      "artifactName": "Relay-${version}-portable.${ext}"
    },
    "appImage": {
      "artifactName": "Relay-${version}.${ext}"
    },
    "deb": {
      "artifactName": "Relay-${version}.${ext}"
    }
  }
}